<ci:SettingsPageBase x:Class="Sentryer.SettingsPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:Sentryer"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                     mc:Ignorable="d"
                     Unloaded="SettingsPage_OnUnloaded">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:SettingsPage}}">
        <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
        <StackPanel Style="{StaticResource SettingsPageStackPanelStyle}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <materialDesign:PackIcon
                    Height="60"
                    Width="60"
                    Kind="Satellite"
                    Foreground="{DynamicResource MaterialDesignBodyLight}"
                    VerticalAlignment="Center"/>
                <Label VerticalAlignment="Center" FontSize="30">Sentryer</Label>
            </StackPanel>
            <ci:SettingsCard IconGlyph="Radar"
                             Header="DSN"
                             Description="设置要链接的Sentry服务">
                <ci:SettingsCard.Switcher>
                    <TextBox Grid.Column="5"
                             MinWidth="20"
                             HorizontalContentAlignment="Center"
                             Margin="3,0,6,0"
                             Text="{Binding Settings.Dsn}"/>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>
            <ci:SettingsCard IconGlyph="Tag"
                             Header="发布版本"
                             Description="填写Release字段,{0}解析到版本号,{1}解析到版本CodeName">
                <ci:SettingsCard.Switcher>
                    <TextBox Grid.Column="5"
                             MinWidth="20"
                             HorizontalContentAlignment="Center"
                             Margin="3,0,6,0"
                             Text="{Binding Settings.Release}"/>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>
            <ci:SettingsCard IconGlyph="TagPlus"
                             Header="分发版本"
                             Description="填写Distribution字段,{0}解析到版本号,{1}解析到版本CodeName">
                <ci:SettingsCard.Switcher>
                    <TextBox Grid.Column="5"
                             MinWidth="20"
                             HorizontalContentAlignment="Center"
                             Margin="3,0,6,0"
                             Text="{Binding Settings.Distribution}"/>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
